{
  "name": "s3-training-day-7-databases",
  "version": "1.0.0",
  "private": true,
  "description": "Day 9 authentication and security training built on the Day 6 Express API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node scripts/db-init.js",
    "db:seed": "node scripts/db-seed.js",
    "db:seed-admin": "node scripts/db-seed-admin.js",
    "db:explain": "node scripts/db-explain.js",
    "db:test:up": "docker compose -p taskflow-test -f docker-compose.test.yml up -d",
    "db:test:init": "node scripts/db-test-init.js",
    "db:test:down": "docker compose -p taskflow-test -f docker-compose.test.yml down",
    "test": "node --test test/api.test.js test/auth.test.js test/database.test.js",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "RUN_DB_TESTS=1 node --test test/api.test.js test/auth.test.js test/database.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.3.0",
    "pg": "^8.13.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.12",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  }
}
