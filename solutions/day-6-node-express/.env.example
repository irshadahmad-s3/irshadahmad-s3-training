PORT=3000
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@localhost:5432/DB_NAME
PGPOOL_MAX=10
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=DB_NAME
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
FRONTEND_ORIGIN=http://localhost:5173
ENABLE_SQL_INJECTION_DEMO=false
# Set locally for npm run db:seed-admin. Never commit your real admin password.
ADMIN_EMAIL=replace-with-your-local-admin-email
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
