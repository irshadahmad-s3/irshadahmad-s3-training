{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",

        "rootDir": "./src",
        "outDir": "./dist",

        "strict": true,
        "noEmitOnError": true,
        "skipLibCheck": true,

        "lib": ["ES2020", "DOM"]
    },

    "include": ["src/**/*"],
    "exclude": ["node_modules"]
}