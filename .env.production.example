# Copy to .env and replace every example secret before running Compose.
# Use URL-safe values (letters and digits) for database passwords.
POSTGRES_USER=taskflow_app
POSTGRES_PASSWORD=replace_with_a_unique_random_url_safe_password
MONGO_INITDB_ROOT_USERNAME=taskflow_admin
MONGO_INITDB_ROOT_PASSWORD=replace_with_another_unique_random_url_safe_password
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters

